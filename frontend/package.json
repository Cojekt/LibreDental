{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "dev": "vite",
    "build:dev": "npm run build:i18n && vite build --minify false --mode development",
    "build": "npm run build:i18n && vite build --mode production",
    "preview": "vite preview",
    "check": "npm run build:i18n && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "format:check": "prettier --check . ../.github",
    "format": "prettier --write . ../.github"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@wailsio/runtime": "latest",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.23.2",
    "@inlang/plugin-m-function-matcher": "^2.2.12",
    "@inlang/plugin-message-format": "^4.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.46.4",
    "svelte-check": "^4.7.5",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
