    "fdi",
    "fluoride",
    "furcation",
    "gingival",
    "gingivitis",
    "gofumpt",
    "gopls",
    "hygienist",
    "hygienists",
    "incisal",
    "incisor",
    "incisors",
    "inlang",
    "interdental",
    "labial",
    "libredental",
    "lingual",
    "mandibular",
